<?xml version="1.0" encoding="UTF-8"?>
<configuration
    xmlns="https://tony19.github.io/logback-android/xml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://tony19.github.io/logback-android/xml https://cdn.jsdelivr.net/gh/tony19/logback-android/logback.xsd"
>
    <appender name="LOGCAT" class="ch.qos.logback.classic.android.LogcatAppender">
        <tagEncoder>
            <pattern>%d{HH:mm:ss.SSS}</pattern>
        </tagEncoder>
        <encoder>
            <pattern>%logger{20} %-5level - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="me.heyteacher.flutter_antplus" level="DEBUG" />
    <logger name="be.glever.antplus.common.datapage.registry.AbstractDataPageRegistry" level="DEBUG" />
    <logger name="be.glever.ant.usb.AbstractAntUsbDevice" level="DEBUG" />
    <logger name="be.glever.ant.usb.impl.AndroidAntUsbDevice" level="DEBUG" />
    <!-- 
    <logger name="be.glever" level="DEBUG" />
    <logger name="be.glever.ant.usb.AntUsbWriter" level="DEBUG" />
    <logger name="be.glever.ant.usb.AntUsbReader" level="DEBUG" />
    <logger name="be.glever.ant.message.AntMessageRegistry" level="DEBUG" />
    -->

    <root level="WARN">
        <appender-ref ref="LOGCAT" />
    </root>
</configuration>